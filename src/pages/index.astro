---
import Layout from '../layouts/Layout.astro';

/**
 * Carta abierta a QlqComida y a la iniciativa QlQ Esta Union.
 * El menu, las promos y el panel siguen en el repo: el home viejo quedo en
 * _index-menu.astro (fuera de las rutas por el guion bajo).
 *
 * El contador de dias cerrados se calcula en cada request (output: 'server'),
 * asi la carta sigue siendo exacta cada dia que pasa sin tener que tocarla.
 */
const TERREMOTO = new Date('2026-06-24T00:00:00-04:00');
const ANO_FUNDACION = 1980;

const ahora = new Date();
const diasCerrados = Math.max(0, Math.floor((ahora.getTime() - TERREMOTO.getTime()) / 86400000));
const anosAbiertos = ahora.getFullYear() - ANO_FUNDACION;
const fechaHoy = ahora.toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });

const INSTAGRAM = 'https://www.instagram.com/restaurantcabokenedyoficial/';
const MAPS = 'https://maps.app.goo.gl/9rWr5kE7a13ZtMde8?g_st=ic';
const WHATSAPP = `https://wa.me/584142920785?text=${encodeURIComponent('Hola, leí la carta de Cabo Kenedy y quiero ayudar.')}`;

const title = 'Carta abierta a QlqComida | Cabo Kenedy, La Guaira';
const description = `Desde 1980 en Caraballeda. Llevamos ${diasCerrados} días con el carbón apagado desde el terremoto del 24 de junio. Esta es nuestra carta a QlQ Esta Unión.`;
---

<Layout title={title} description={description}>
  <!-- Brasas de fondo -->
  <div class="embers" aria-hidden="true">
    {Array.from({ length: 14 }).map((_, i) => (
      <span class="ember" style={`left:${4 + i * 7}%; animation-delay:${i * 1.7}s; animation-duration:${13 + (i % 5) * 3}s;`} />
    ))}
  </div>

  <main class="relative px-5 sm:px-8 pb-24">
    <!-- ==================== ENCABEZADO ==================== -->
    <header class="max-w-2xl mx-auto pt-14 sm:pt-20 text-center">
      <!-- logo-trim: el logo.webp original trae el arte (484x369) dentro de un
           lienzo de 600x600, o sea 40% de aire que lo hacia verse diminuto. -->
      <img
        src="/logo-trim.webp"
        alt="Cabo Kenedy"
        width="484"
        height="369"
        class="w-44 sm:w-52 h-auto mx-auto mb-8"
      />

      <p class="font-display text-[10px] sm:text-xs tracking-[0.35em] text-primary/80 mb-6">
        CARTA ABIERTA
      </p>

      <div class="inline-flex flex-col gap-1 text-sm text-text-muted font-heading mb-10">
        <span><span class="text-text-secondary">Para:</span> QlqComida y la gente de QlQ Esta Unión</span>
        <span><span class="text-text-secondary">De:</span> la familia de Cabo Kenedy, Caraballeda</span>
        <span><span class="text-text-secondary">Fecha:</span> {fechaHoy}</span>
      </div>

      <h1 class="font-heading text-3xl sm:text-5xl font-bold leading-[1.15] text-text-primary text-balance">
        Hace <span class="text-primary">{diasCerrados} días</span> que no encendemos el carbón.
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-text-secondary leading-relaxed text-balance">
        Antes de eso, llevábamos {anosAbiertos} años sin fallar un domingo.
      </p>
    </header>

    <!-- ==================== EL CONTADOR ==================== -->
    <section class="max-w-2xl mx-auto mt-14 reveal" aria-label="Situación actual">
      <div class="grid grid-cols-3 gap-px bg-white/8 rounded-2xl overflow-hidden border border-white/8">
        <div class="bg-space-card px-3 py-6 text-center">
          <div class="font-display text-2xl sm:text-4xl font-bold text-primary">{diasCerrados}</div>
          <div class="text-[11px] sm:text-xs text-text-muted mt-2 font-heading">días cerrados</div>
        </div>
        <div class="bg-space-card px-3 py-6 text-center">
          <div class="font-display text-2xl sm:text-4xl font-bold text-text-primary">{anosAbiertos}</div>
          <div class="text-[11px] sm:text-xs text-text-muted mt-2 font-heading">años de historia</div>
        </div>
        <div class="bg-space-card px-3 py-6 text-center">
          <div class="font-display text-2xl sm:text-4xl font-bold text-text-primary">24-J</div>
          <div class="text-[11px] sm:text-xs text-text-muted mt-2 font-heading">el día que tembló</div>
        </div>
      </div>
    </section>

    <!-- ==================== LA CARTA ==================== -->
    <article class="carta max-w-[38rem] mx-auto mt-20">
      <p class="reveal">Queridos QlqComida:</p>

      <p class="reveal">
        Les escribimos desde el Local 01 de la avenida principal de Caribe, en el C.C. Houston,
        en Caraballeda. O más bien, desde lo que el 24 de junio dejó de él.
      </p>

      <p class="reveal">
        <strong>Cabo Kenedy abrió en 1980.</strong> Pollo a la brasa sobre carbón natural, un adobo
        que no está escrito en ningún papel porque se aprende mirando, arepitas y esa ensalada
        rallada de repollo y zanahoria que la gente termina pidiendo aparte porque nunca le alcanza.
        {anosAbiertos} años haciendo casi exactamente lo mismo, todos los días, sin inventar mucho.
      </p>

      <p class="reveal">
        Durante {anosAbiertos} años, a las once de la mañana la avenida olía a nosotros. Ese olor
        era nuestra manera de dar los buenos días. La gente que pasaba en carro bajaba el vidrio
        sin pensarlo. Eso no se pone en un menú, pero era lo que vendíamos.
      </p>

      <p class="reveal">
        Y en este pueblo hay una escena que se repite sola. Alguien llega, se sienta y al tiempo
        aparece con un hijo. Años después ese hijo vuelve y trae al suyo. Nosotros no hemos hecho
        gran cosa: pusimos las sillas y mantuvimos la brasa prendida mientras eso pasaba.
      </p>

      <blockquote class="reveal">
        A mi papá lo trajo mi abuelo. A mí me trajo mi papá.
        Y yo tenía la idea más normal del mundo: traer un día a mis hijos, sentarlos ahí y decirles
        <em>aquí comía tu bisabuelo y sabe igual que hace cuarenta años.</em>
      </blockquote>

      <p class="reveal">
        Todavía no se lo he podido decir a nadie.
      </p>

      <div class="grieta reveal" aria-hidden="true"></div>

      <p class="reveal">
        El 24 de junio tembló en La Guaira y nuestro local quedó fuera de servicio. Desde entonces
        no hemos vuelto a abrir. Llevamos <strong>{diasCerrados} días</strong> con las santamarías
        abajo: el silencio más largo en {anosAbiertos} años. Más largo que cualquier vaguada,
        cualquier apagón y cualquier cuarentena que nos haya tocado aguantar.
      </p>

      <p class="reveal">
        Lo duro de un restaurante cerrado no es la puerta cerrada. Es todo lo que se apaga detrás:
        el señor que venía los jueves y ya no tiene jueves. La familia que celebraba ahí los
        cumpleaños porque salía más a cuenta que un salón. Los muchachos que llegaban tarde en la
        noche. La gente que trabaja con nosotros, que no cocina por hobby sino porque de ahí come
        su casa. Cuando un negocio de barrio cierra, no cierra un negocio: se le apaga una costumbre
        a un pueblo entero.
      </p>

      <p class="reveal">
        Y este pueblo ya sabe lo que es rehacerse. Lo hizo en el 99, cuando bajó el cerro y La
        Guaira tuvo que aprender a levantarse encima de lo que quedó. Sabemos empezar otra vez.
        Lo que no sabemos es hacerlo solos.
      </p>

      <div class="grieta reveal" aria-hidden="true"></div>

      <p class="reveal">
        Hay una idea que nos ha dado vueltas estos meses: que cada persona tiene una chispa, eso
        que la enciende, lo que hace que valga la pena levantarse temprano. Nosotros creemos que
        los pueblos también tienen la suya y que casi nunca está en un monumento ni en una plaza,
        sino en un local pequeño donde alguien lleva media vida haciendo una sola cosa, bien hecha.
      </p>

      <p class="reveal">
        La nuestra fue literal durante {anosAbiertos} años: <strong>una brasa encendida</strong>.
        No se apagó porque nos cansamos, ni porque la comida dejó de gustar, ni porque la gente
        dejó de venir. Se apagó porque tembló.
      </p>

      <p class="reveal">
        Vimos lo que están haciendo con <strong>QlQ Esta Unión</strong> y llenamos el formulario,
        como tantos otros negocios de aquí. Pero en un formulario no cabe el olor del carbón a las
        once de la mañana, ni la cara de mi abuelo, ni la cuenta de las familias que dependen de
        que esa cocina vuelva a prender. Por eso hicimos esta página: es lo que no cabía en el
        formulario.
      </p>
    </article>

    <!-- ==================== KINTSUGI ==================== -->
    <section class="kintsugi-section" aria-label="Kintsugi: reparar con oro">
      <div class="kintsugi-wrap reveal">
        <svg class="kintsugi-svg" viewBox="0 0 220 220" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="oro" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#bf953f" />
              <stop offset="25%" stop-color="#fcf6ba" />
              <stop offset="50%" stop-color="#b38728" />
              <stop offset="75%" stop-color="#fbf5b7" />
              <stop offset="100%" stop-color="#aa771c" />
            </linearGradient>
            <radialGradient id="halo" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(240,176,0,0.10)" />
              <stop offset="100%" stop-color="rgba(240,176,0,0)" />
            </radialGradient>
          </defs>

          <!-- Halo -->
          <circle cx="110" cy="110" r="105" fill="url(#halo)" class="k-aura" />

          <!-- El plato: borde y fondo -->
          <circle cx="110" cy="110" r="88" class="k-plato" />
          <circle cx="110" cy="110" r="62" class="k-plato k-plato-hondo" />

          <!-- Grietas de oro: se dibujan solas al entrar en pantalla -->
          <path class="k-grieta" style="--d:0.0s" d="M110 22 C 106 52, 118 70, 112 92 C 108 108, 116 124, 110 148 C 106 168, 114 186, 110 198" />
          <path class="k-grieta" style="--d:0.5s" d="M112 92 C 92 88, 74 78, 52 62" />
          <path class="k-grieta" style="--d:0.9s" d="M110 148 C 132 146, 152 154, 176 168" />
          <path class="k-grieta" style="--d:1.2s" d="M112 92 C 130 84, 148 72, 162 54" />
          <path class="k-grieta" style="--d:1.5s" d="M110 148 C 90 158, 72 170, 58 184" />
          <path class="k-grieta k-fina" style="--d:1.8s" d="M52 62 C 44 74, 38 84, 30 92" />
          <path class="k-grieta k-fina" style="--d:2.0s" d="M176 168 C 182 176, 186 182, 190 190" />

          <!-- Nodos en las uniones -->
          <circle cx="112" cy="92" r="2.6" class="k-nodo" style="--d:2.2s" />
          <circle cx="110" cy="148" r="2.6" class="k-nodo" style="--d:2.35s" />
        </svg>
      </div>

      <p class="k-kanji reveal">金継ぎ</p>
      <h2 class="k-titulo reveal">Kintsugi</h2>
      <p class="k-def reveal">El arte japonés de reparar con oro</p>
      <div class="k-regla reveal" aria-hidden="true"></div>

      <div class="carta max-w-[38rem] mx-auto text-center">
        <p class="reveal">
          Cuando un plato se rompe hay dos maneras de responder: esconderlo o unir los pedazos con
          oro y dejar la grieta a la vista, porque la grieta también es parte de la historia de la
          pieza.
        </p>

        <p class="k-cierre reveal">
          No les estamos pidiendo que Cabo Kenedy vuelva a ser exactamente lo que era el 23 de junio.
          Un sitio que se cae y se levanta no vuelve igual: vuelve con una historia más que contar,
          y esa historia se la contamos a todo el que se siente en una de nuestras mesas.
        </p>

        <p class="k-remate reveal">
          Los pedazos están todos.<br />
          <span>Lo único que nos falta es el oro.</span>
        </p>
      </div>
    </section>

    <!-- ==================== FIRMA ==================== -->
    <div class="max-w-[38rem] mx-auto mt-16 carta">
      <p class="reveal">
        Si algo de esto les llega, aquí estamos. Y si no, gracias igual por estar preguntando quién
        quedó abajo en La Guaira. Que alguien pregunte, después de {diasCerrados} días, ya es
        bastante.
      </p>

      <div class="firma reveal">
        <p class="font-heading text-text-primary text-lg font-semibold">La familia de Cabo Kenedy</p>
        <p class="text-sm text-text-muted mt-1">Caraballeda, La Guaira · desde 1980</p>
        <p class="text-xs text-text-muted/80 mt-4 leading-relaxed">
          Esta página la armó Carlos Jardim, primo del dueño, con el visto bueno de la familia.
        </p>
      </div>
    </div>

    <!-- ==================== SOMOS REALES ==================== -->
    <section class="max-w-[38rem] mx-auto mt-20 reveal" aria-label="Cómo verificar que existimos">
      <h2 class="font-display text-xs tracking-[0.25em] text-primary/80 text-center mb-8">
        PARA QUIEN REVISE ESTO
      </h2>

      <div class="space-y-3">
        <a href={MAPS} target="_blank" rel="noopener" class="dato">
          <span class="dato-label">Dónde estamos</span>
          <span class="dato-valor">Local 01, Av. Principal de Caribe, C.C. Houston PB, Caraballeda 1165, La Guaira</span>
          <span class="dato-accion">Ver en Google Maps</span>
        </a>

        <a href={INSTAGRAM} target="_blank" rel="noopener" class="dato">
          <span class="dato-label">Nuestro Instagram</span>
          <span class="dato-valor">@restaurantcabokenedyoficial</span>
          <span class="dato-accion">Ahí está el antes: las fotos, la gente, los {anosAbiertos} años</span>
        </a>

        <a href={WHATSAPP} target="_blank" rel="noopener" class="dato">
          <span class="dato-label">Hablar con nosotros</span>
          <span class="dato-valor">0414-292-0785</span>
          <span class="dato-accion">Escríbenos por WhatsApp</span>
        </a>
      </div>
    </section>

    <!-- ==================== CIERRE ==================== -->
    <footer class="max-w-[38rem] mx-auto mt-20 text-center">
      <p class="font-heading text-xl sm:text-2xl text-text-primary leading-snug text-balance reveal">
        {anosAbiertos} años encendido.<br />
        <span class="text-primary">{diasCerrados} días apagado.</span><br />
        Nos falta una chispa.
      </p>

      <img
        src="/logo-trim.webp"
        alt=""
        width="484"
        height="369"
        class="w-20 h-auto mx-auto mt-12 opacity-40"
        aria-hidden="true"
      />
      <p class="text-xs text-text-muted mt-4 font-heading">
        Cabo Kenedy · Pollo a la brasa · Caraballeda, La Guaira
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* ---------- Brasas que suben ---------- */
  .embers {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ember {
    position: absolute;
    bottom: -10px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-primary-light);
    box-shadow: 0 0 8px 2px rgba(232, 122, 30, 0.5);
    opacity: 0;
    animation-name: emberRise;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
  }

  @keyframes emberRise {
    0%   { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
    12%  { opacity: 0.7; }
    70%  { opacity: 0.35; }
    100% { transform: translateY(-100vh) translateX(28px) scale(0.3); opacity: 0; }
  }

  /* ---------- Cuerpo de la carta ---------- */
  .carta {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .carta :global(p) {
    margin-bottom: 1.6rem;
  }

  .carta :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .carta :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1.5rem 0 1.5rem 1.5rem;
    border-left: 2px solid var(--color-primary);
    color: var(--color-text-primary);
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .carta :global(blockquote em) {
    color: var(--color-primary-light);
    font-style: italic;
  }

  /* Separador: una grieta fina con luz de oro en el centro */
  .grieta {
    height: 1px;
    margin: 3rem auto;
    width: 70%;
    background: linear-gradient(90deg, transparent, rgba(191, 149, 63, 0.15) 20%, rgba(252, 246, 186, 0.55) 50%, rgba(191, 149, 63, 0.15) 80%, transparent);
  }

  .firma {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* ---------- Kintsugi ---------- */
  .kintsugi-section {
    margin-top: 6rem;
    padding: 4rem 0 1rem;
    text-align: center;
    background: radial-gradient(ellipse 55% 45% at 50% 45%, rgba(240, 176, 0, 0.05), transparent 70%);
  }

  .kintsugi-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .kintsugi-svg {
    width: clamp(180px, 42vw, 260px);
    height: auto;
    overflow: visible;
  }

  .k-plato {
    fill: none;
    stroke: rgba(240, 176, 0, 0.18);
    stroke-width: 1;
  }

  .k-plato-hondo {
    stroke: rgba(240, 176, 0, 0.10);
  }

  .k-grieta {
    fill: none;
    stroke: url(#oro);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    filter: drop-shadow(0 0 4px rgba(240, 176, 0, 0.55));
  }

  .k-fina { stroke-width: 1.4; }

  .k-nodo {
    fill: url(#oro);
    opacity: 0;
    filter: drop-shadow(0 0 5px rgba(240, 176, 0, 0.8));
  }

  /* Las grietas se dibujan cuando el plato entra en pantalla */
  :global(.kintsugi-wrap.visible) .k-grieta {
    animation: dibujarGrieta 1.8s ease-out forwards;
    animation-delay: var(--d, 0s);
  }

  :global(.kintsugi-wrap.visible) .k-nodo {
    animation: aparecerNodo 0.8s ease-out forwards;
    animation-delay: var(--d, 0s);
  }

  @keyframes dibujarGrieta {
    to { stroke-dashoffset: 0; }
  }

  @keyframes aparecerNodo {
    to { opacity: 0.9; }
  }

  .k-aura {
    animation: auraPulso 6s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes auraPulso {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.05); }
  }

  .k-kanji {
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: rgba(240, 176, 0, 0.55);
    margin-bottom: 1rem;
  }

  .k-titulo {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    background: linear-gradient(135deg, #bf953f, #fcf6ba, #b38728, #fbf5b7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.5rem;
  }

  .k-def {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .k-regla {
    width: 60px;
    height: 1px;
    margin: 2.5rem auto 3rem;
    background: linear-gradient(90deg, transparent, rgba(252, 246, 186, 0.6), transparent);
  }

  .k-cierre {
    color: var(--color-text-primary);
  }

  .k-remate {
    margin-top: 2.5rem;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3.5vw, 1.6rem);
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  .k-remate span {
    /* Gradiente mas claro que el del titulo: en una linea larga los tonos
       oscuros del oro se vuelven ilegibles sobre el fondo negro. */
    background: linear-gradient(135deg, #e8c66a, #fcf6ba, #f0d878, #fbf5b7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 700;
  }

  /* ---------- Datos verificables ---------- */
  .dato {
    display: block;
    padding: 1.125rem 1.25rem;
    border-radius: 1rem;
    background: var(--color-space-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .dato:hover {
    border-color: rgba(232, 122, 30, 0.35);
    background: var(--color-space-card-hover);
    transform: translateY(-2px);
  }

  .dato-label {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .dato-valor {
    display: block;
    color: var(--color-text-primary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .dato-accion {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-primary);
  }

  /* ---------- Aparicion al hacer scroll ----------
     Solo se oculta si el JS llego a correr: sin JS todo se ve igual. */
  :global(body.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(18px);
  }

  :global(body.js-reveal) .reveal.visible {
    opacity: 1;
    transform: none;
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .ember { display: none; }
    .k-aura { animation: none; }
    .k-grieta { stroke-dashoffset: 0; }
    .k-nodo { opacity: 0.9; }
    :global(body.js-reveal) .reveal,
    :global(body.js-reveal) .reveal.visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length && 'IntersectionObserver' in window) {
    document.body.classList.add('js-reveal');
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        // Tambien se muestra lo que ya quedo por encima de la pantalla: si
        // alguien entra con el scroll a mitad de pagina, esos bloques nunca
        // llegarian a "entrar" y se quedarian invisibles para siempre.
        const yaPaso = entry.boundingClientRect.top < 0;
        if (entry.isIntersecting || yaPaso) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      }
    }, { rootMargin: '0px 0px -12% 0px' });
    reveals.forEach((el) => io.observe(el));
  }
</script>
