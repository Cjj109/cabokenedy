---
import Layout from '../layouts/Layout.astro';

/**
 * V2 de la carta abierta a QlqComida y a la iniciativa QlQ Esta Union.
 * El menu, las promos y el panel siguen en el repo: el home viejo quedo en
 * _index-menu.astro (fuera de las rutas por el guion bajo).
 *
 * El contador de dias cerrados se calcula en cada request (output: 'server'),
 * asi la carta sigue siendo exacta cada dia que pasa sin tener que tocarla.
 */
const TERREMOTO = new Date('2026-06-24T00:00:00-04:00');
const ANO_FUNDACION = 1980;

const ahora = new Date();
const diasCerrados = Math.max(0, Math.floor((ahora.getTime() - TERREMOTO.getTime()) / 86400000));
const anosAbiertos = ahora.getFullYear() - ANO_FUNDACION;
const fechaHoy = ahora.toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });

/**
 * Fotos reales, en orden narrativo: antes -> generaciones -> el restaurante
 * -> el cierre -> la esperanza. La seccion no aparece mientras este vacio.
 * Para activarla: poner los archivos en public/fotos/ y descomentar.
 */
const fotos: { src: string; pie: string }[] = [
  // { src: '/fotos/1-antes.webp',        pie: 'El local cuando abrió, en los ochenta.' },
  // { src: '/fotos/2-generaciones.webp', pie: 'Mi abuelo, mi papá y yo.' },
  // { src: '/fotos/3-brasa.webp',        pie: 'El carbón, todos los días a las once de la mañana.' },
  // { src: '/fotos/4-cerrado.webp',      pie: 'El 24 de junio.' },
  // { src: '/fotos/5-esperanza.webp',    pie: 'La cocina, esperando.' },
];

const INSTAGRAM = 'https://www.instagram.com/restaurantcabokenedyoficial/';
const MAPS = 'https://maps.app.goo.gl/9rWr5kE7a13ZtMde8?g_st=ic';
const WHATSAPP = `https://wa.me/584142920785?text=${encodeURIComponent('Hola, leí la carta de Cabo Kenedy.')}`;

const title = 'Carta abierta a QlqComida | Cabo Kenedy, La Guaira';
const description = `Desde 1980 en Caraballeda. Llevamos ${diasCerrados} días con el carbón apagado desde el terremoto del 24 de junio. Esta es nuestra carta a QlQ Esta Unión.`;
---

<Layout title={title} description={description}>
  <div class="embers" aria-hidden="true">
    {Array.from({ length: 14 }).map((_, i) => (
      <span class="ember" style={`left:${4 + i * 7}%; animation-delay:${i * 1.7}s; animation-duration:${13 + (i % 5) * 3}s;`} />
    ))}
  </div>

  <main class="relative">
    <!-- ==================== 1. APERTURA ==================== -->
    <header class="escena escena-alta text-center">
      <img
        src="/logo-trim.webp"
        alt="Cabo Kenedy"
        width="484"
        height="369"
        class="w-44 sm:w-52 h-auto mx-auto mb-10"
      />

      <p class="kicker">CARTA ABIERTA A QLQCOMIDA</p>

      <h1 class="titular">
        Hace <span class="text-primary">{diasCerrados} días</span><br />
        que no encendemos el carbón.
      </h1>
    </header>

    <!-- ==================== 2. LAS GENERACIONES ==================== -->
    <section class="escena escena-alta text-center" aria-label="Tres generaciones">
      <p class="verso reveal">A mi papá lo trajo mi abuelo.</p>
      <p class="verso reveal">A mí me trajo mi papá.</p>
      <p class="verso verso-final reveal">A mis hijos todavía no he podido traerlos.</p>
    </section>

    <!-- ==================== 3. QUIÉNES SOMOS ==================== -->
    <section class="escena carta" aria-label="Quiénes somos">
      <p class="reveal">
        <strong>Cabo Kenedy abrió en 1980</strong>, en el Local 01 de la avenida principal de
        Caribe, en Caraballeda. Pollo a la brasa sobre carbón, un adobo que no está escrito en
        ningún papel porque se aprende mirando, arepitas y la ensalada rallada de repollo y
        zanahoria. {anosAbiertos} años haciendo lo mismo todos los días.
      </p>

      <p class="reveal">
        Durante {anosAbiertos} años, a las once de la mañana la avenida olía a nosotros.
      </p>
    </section>

    {fotos.length > 0 && (
      <section class="escena" aria-label="Fotos">
        <div class="tira">
          {fotos.map((foto) => (
            <figure class="foto reveal">
              <img src={foto.src} alt={foto.pie} loading="lazy" />
              <figcaption>{foto.pie}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ==================== 4. EL 24 DE JUNIO ==================== -->
    <section class="escena escena-alta text-center" aria-label="El 24 de junio">
      <p class="fecha-grande reveal" aria-hidden="true">24<span>·</span>06</p>
      <p class="verso reveal">Tembló.</p>
      <p class="verso verso-final reveal">No hemos vuelto a abrir.</p>

      <div class="contador reveal">
        <span class="contador-num">{diasCerrados}</span>
        <span class="contador-txt">días cerrados</span>
      </div>
    </section>

    <!-- ==================== 5. LO QUE SE APAGÓ ==================== -->
    <section class="escena carta" aria-label="Lo que se apagó">
      <p class="reveal">
        El señor que venía los jueves. Los cumpleaños que se celebraban aquí porque salía más a
        cuenta que un salón. Los muchachos que llegaban de madrugada.
      </p>

      <p class="reveal">
        Y la gente que trabaja con nosotros, que no cocina por gusto: de esa cocina come su casa.
        Llevan {diasCerrados} días esperando, igual que nosotros.
      </p>
    </section>

    <!-- ==================== 6. LA CHISPA ==================== -->
    <section class="escena carta" aria-label="La chispa">
      <p class="reveal">
        Dicen que cada persona tiene una chispa: eso que la enciende, lo que hace que valga la pena
        levantarse temprano. Los pueblos también tienen la suya, y casi nunca está en una plaza.
      </p>

      <p class="reveal">
        La nuestra fue literal durante {anosAbiertos} años: una brasa. No se apagó porque nos
        cansamos. Se apagó porque tembló.
      </p>
    </section>

    <!-- ==================== 7. KINTSUGI ==================== -->
    <section class="escena kintsugi-section text-center" aria-label="Kintsugi">
      <div class="kintsugi-wrap reveal">
        <svg class="kintsugi-svg" viewBox="0 0 220 220" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="oro" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#bf953f" />
              <stop offset="25%" stop-color="#fcf6ba" />
              <stop offset="50%" stop-color="#b38728" />
              <stop offset="75%" stop-color="#fbf5b7" />
              <stop offset="100%" stop-color="#aa771c" />
            </linearGradient>
            <radialGradient id="halo" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(240,176,0,0.10)" />
              <stop offset="100%" stop-color="rgba(240,176,0,0)" />
            </radialGradient>
          </defs>

          <circle cx="110" cy="110" r="105" fill="url(#halo)" class="k-aura" />
          <circle cx="110" cy="110" r="88" class="k-plato" />
          <circle cx="110" cy="110" r="62" class="k-plato k-plato-hondo" />

          <path class="k-grieta" style="--d:0.0s" d="M110 22 C 106 52, 118 70, 112 92 C 108 108, 116 124, 110 148 C 106 168, 114 186, 110 198" />
          <path class="k-grieta" style="--d:0.5s" d="M112 92 C 92 88, 74 78, 52 62" />
          <path class="k-grieta" style="--d:0.9s" d="M110 148 C 132 146, 152 154, 176 168" />
          <path class="k-grieta" style="--d:1.2s" d="M112 92 C 130 84, 148 72, 162 54" />
          <path class="k-grieta" style="--d:1.5s" d="M110 148 C 90 158, 72 170, 58 184" />
          <path class="k-grieta k-fina" style="--d:1.8s" d="M52 62 C 44 74, 38 84, 30 92" />
          <path class="k-grieta k-fina" style="--d:2.0s" d="M176 168 C 182 176, 186 182, 190 190" />

          <circle cx="112" cy="92" r="2.6" class="k-nodo" style="--d:2.2s" />
          <circle cx="110" cy="148" r="2.6" class="k-nodo" style="--d:2.35s" />
        </svg>
      </div>

      <p class="k-kanji reveal">金継ぎ</p>
      <h2 class="k-titulo reveal">Kintsugi</h2>
      <p class="k-def reveal">El arte japonés de reparar con oro</p>

      <div class="carta max-w-[34rem] mx-auto mt-12">
        <p class="reveal">
          Los japoneses no esconden la grieta: la rellenan de oro y la dejan a la vista, porque
          también es parte de la pieza.
        </p>
        <p class="reveal">
          No pedimos volver a ser lo que éramos el 23 de junio. Los pedazos están todos.
        </p>
      </div>

      <p class="k-remate reveal">Lo único que falta es el oro.</p>
    </section>

    <!-- ==================== 8. LA PETICIÓN ==================== -->
    <section class="escena carta" aria-label="Lo que les pedimos">
      <p class="reveal">
        Así que esto es lo que les pedimos, sin rodeos: <strong>vengan a Caraballeda</strong>.
        Siéntense donde se sentó mi abuelo, prueben el pollo y, si les parece que esto vale la
        pena, cuéntenlo.
      </p>

      <p class="reveal">
        No estamos pidiendo plata. Estamos pidiendo que se sepa que Cabo Kenedy sigue aquí y quiere
        volver a abrir.
      </p>

      <div class="acciones reveal">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-wa">
          Escríbenos por WhatsApp
        </a>
        <a href={INSTAGRAM} target="_blank" rel="noopener" class="btn btn-ig">
          @restaurantcabokenedyoficial
        </a>
      </div>
    </section>

    <!-- ==================== 9. CIERRE ==================== -->
    <section class="escena escena-alta text-center" aria-label="Cierre">
      <p class="verso reveal">El carbón está ahí.</p>
      <p class="verso reveal">La receta está ahí.</p>
      <p class="verso reveal">Nosotros estamos aquí.</p>
      <p class="cierre-remate reveal">Solo falta encenderlo.</p>

      <div class="firma reveal">
        <p class="firma-nombre">La familia de Cabo Kenedy</p>
        <p class="firma-lugar">Caraballeda, La Guaira · desde 1980 · {fechaHoy}</p>
      </div>
    </section>

    <!-- ==================== PIE ==================== -->
    <footer class="pie">
      <a href={MAPS} target="_blank" rel="noopener" class="pie-dir">
        Local 01, Av. Principal de Caribe, C.C. Houston PB<br />
        Caraballeda 1165, La Guaira
      </a>

      <div class="pie-enlaces">
        <a href={WHATSAPP} target="_blank" rel="noopener">0414-292-0785</a>
        <span aria-hidden="true">·</span>
        <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
      </div>

      <p class="pie-nota">
        Esta página la armó Carlos Jardim, primo del dueño, con el visto bueno de la familia.
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* ---------- Brasas ---------- */
  .embers {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ember {
    position: absolute;
    bottom: -10px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-primary-light);
    box-shadow: 0 0 8px 2px rgba(232, 122, 30, 0.5);
    opacity: 0;
    animation-name: emberRise;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
  }

  @keyframes emberRise {
    0%   { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
    12%  { opacity: 0.7; }
    70%  { opacity: 0.35; }
    100% { transform: translateY(-100vh) translateX(28px) scale(0.3); opacity: 0; }
  }

  /* ---------- Escenas: el aire entre bloques es parte del mensaje ---------- */
  .escena {
    position: relative;
    max-width: 34rem;
    margin: 0 auto;
    padding: 5.5rem 1.5rem;
  }

  .escena-alta {
    padding-top: 8rem;
    padding-bottom: 8rem;
  }

  @media (min-width: 640px) {
    .escena { padding: 7rem 2rem; }
    .escena-alta { padding-top: 11rem; padding-bottom: 11rem; }
  }

  .kicker {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.32em;
    color: rgba(232, 122, 30, 0.8);
    margin-bottom: 2rem;
  }

  .titular {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 7.5vw, 3rem);
    font-weight: 700;
    line-height: 1.18;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  /* ---------- Versos: una linea por respiracion ---------- */
  .verso {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 4.6vw, 1.75rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .verso-final {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .cierre-remate {
    margin-top: 2.5rem;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 6vw, 2.4rem);
    font-weight: 700;
    color: var(--color-primary);
    text-wrap: balance;
  }

  /* ---------- Parrafos ---------- */
  .carta {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .carta :global(p) {
    margin-bottom: 1.6rem;
  }

  .carta :global(p:last-child) {
    margin-bottom: 0;
  }

  .carta :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* ---------- El 24 de junio ---------- */
  .fecha-grande {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 16vw, 6rem);
    font-weight: 800;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(232, 122, 30, 0.55);
    margin-bottom: 2.5rem;
    letter-spacing: 0.02em;
  }

  .fecha-grande span {
    -webkit-text-stroke: 0;
    color: rgba(232, 122, 30, 0.55);
    margin: 0 0.15em;
  }

  .contador {
    margin-top: 3rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contador-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 11vw, 4rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .contador-txt {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---------- Fotos ---------- */
  .tira {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .foto img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: block;
  }

  .foto figcaption {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* ---------- Kintsugi ---------- */
  .kintsugi-section {
    max-width: 40rem;
    background: radial-gradient(ellipse 55% 45% at 50% 45%, rgba(240, 176, 0, 0.05), transparent 70%);
  }

  .kintsugi-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .kintsugi-svg {
    width: clamp(170px, 40vw, 240px);
    height: auto;
    overflow: visible;
  }

  .k-plato { fill: none; stroke: rgba(240, 176, 0, 0.18); stroke-width: 1; }
  .k-plato-hondo { stroke: rgba(240, 176, 0, 0.10); }

  .k-grieta {
    fill: none;
    stroke: url(#oro);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    filter: drop-shadow(0 0 4px rgba(240, 176, 0, 0.55));
  }

  .k-fina { stroke-width: 1.4; }

  .k-nodo {
    fill: url(#oro);
    opacity: 0;
    filter: drop-shadow(0 0 5px rgba(240, 176, 0, 0.8));
  }

  :global(.kintsugi-wrap.visible) .k-grieta {
    animation: dibujarGrieta 1.8s ease-out forwards;
    animation-delay: var(--d, 0s);
  }

  :global(.kintsugi-wrap.visible) .k-nodo {
    animation: aparecerNodo 0.8s ease-out forwards;
    animation-delay: var(--d, 0s);
  }

  @keyframes dibujarGrieta { to { stroke-dashoffset: 0; } }
  @keyframes aparecerNodo { to { opacity: 0.9; } }

  .k-aura { animation: auraPulso 6s ease-in-out infinite; transform-origin: center; }

  @keyframes auraPulso {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.05); }
  }

  .k-kanji {
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: rgba(240, 176, 0, 0.55);
    margin-bottom: 0.9rem;
  }

  .k-titulo {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 5vw, 2.25rem);
    font-weight: 700;
    background: linear-gradient(135deg, #bf953f, #fcf6ba, #b38728, #fbf5b7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.4rem;
  }

  .k-def {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .k-remate {
    margin-top: 3rem;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 4.5vw, 1.85rem);
    font-weight: 700;
    line-height: 1.4;
    background: linear-gradient(135deg, #e8c66a, #fcf6ba, #f0d878, #fbf5b7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-wrap: balance;
  }

  /* ---------- Acciones ---------- */
  .acciones {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .btn {
    display: block;
    text-align: center;
    padding: 1.05rem 1.5rem;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .btn:active { transform: scale(0.98); }

  .btn-wa {
    background: var(--color-whatsapp);
    color: #05300f;
  }

  .btn-wa:hover { background: #34e07a; }

  .btn-ig {
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  .btn-ig:hover {
    border-color: rgba(232, 122, 30, 0.4);
    color: var(--color-text-primary);
  }

  @media (min-width: 640px) {
    .acciones { flex-direction: row; justify-content: center; }
    .btn { padding: 1rem 2rem; }
  }

  /* ---------- Firma ---------- */
  .firma {
    margin-top: 5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .firma-nombre {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .firma-lugar {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* ---------- Pie ---------- */
  .pie {
    max-width: 34rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .pie-dir {
    display: block;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .pie-dir:hover { color: var(--color-text-secondary); }

  .pie-enlaces {
    margin-top: 1.25rem;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .pie-enlaces a { color: var(--color-primary); }

  .pie-nota {
    margin-top: 2.5rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(138, 127, 116, 0.75);
  }

  /* ---------- Aparicion al hacer scroll ---------- */
  :global(body.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(18px);
  }

  :global(body.js-reveal) .reveal.visible {
    opacity: 1;
    transform: none;
    transition: opacity 0.9s ease, transform 0.9s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .ember { display: none; }
    .k-aura { animation: none; }
    .k-grieta { stroke-dashoffset: 0; }
    .k-nodo { opacity: 0.9; }
    :global(body.js-reveal) .reveal,
    :global(body.js-reveal) .reveal.visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length && 'IntersectionObserver' in window) {
    document.body.classList.add('js-reveal');
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        // Tambien se muestra lo que ya quedo por encima de la pantalla: si
        // alguien entra con el scroll a mitad de pagina, esos bloques nunca
        // llegarian a "entrar" y se quedarian invisibles para siempre.
        const yaPaso = entry.boundingClientRect.top < 0;
        if (entry.isIntersecting || yaPaso) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      }
    }, { rootMargin: '0px 0px -12% 0px' });
    reveals.forEach((el) => io.observe(el));
  }
</script>
