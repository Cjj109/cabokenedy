---
import Layout from '../layouts/Layout.astro';

/**
 * V2 de la carta abierta a QlqComida y a la iniciativa QlQ Esta Union.
 * El menu, las promos y el panel siguen en el repo: el home viejo quedo en
 * _index-menu.astro (fuera de las rutas por el guion bajo).
 *
 * El contador de dias cerrados se calcula en cada request (output: 'server'),
 * asi la carta sigue siendo exacta cada dia que pasa sin tener que tocarla.
 */
const TERREMOTO = new Date('2026-06-24T00:00:00-04:00');
const ANO_FUNDACION = 1980;

const ahora = new Date();
const diasCerrados = Math.max(0, Math.floor((ahora.getTime() - TERREMOTO.getTime()) / 86400000));
const anosAbiertos = ahora.getFullYear() - ANO_FUNDACION;
const fechaHoy = ahora.toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });

/**
 * Fotos reales, en orden narrativo: antes -> generaciones -> el restaurante
 * -> el cierre -> la esperanza. La seccion no aparece mientras este vacio.
 * Para activarla: poner los archivos en public/fotos/ y descomentar.
 */
const fotos: { src: string; pie: string }[] = [
  // { src: '/fotos/1-antes.webp',        pie: 'El local cuando abrió, en los ochenta.' },
  // { src: '/fotos/2-generaciones.webp', pie: 'Mi abuelo, mi papá y yo.' },
  // { src: '/fotos/3-brasa.webp',        pie: 'El carbón, todos los días a las once de la mañana.' },
  // { src: '/fotos/4-cerrado.webp',      pie: 'El 24 de junio.' },
  // { src: '/fotos/5-esperanza.webp',    pie: 'La cocina, esperando.' },
];

const INSTAGRAM = 'https://www.instagram.com/restaurantcabokenedyoficial/';
const MAPS = 'https://maps.app.goo.gl/9rWr5kE7a13ZtMde8?g_st=ic';
const WHATSAPP = `https://wa.me/584142920785?text=${encodeURIComponent('Hola, leí la carta de Cabo Kenedy.')}`;

const title = 'Carta abierta a QlqComida | Cabo Kenedy, La Guaira';
const description = `Desde 1980 en Caraballeda. Llevamos ${diasCerrados} días con el carbón apagado desde el terremoto del 24 de junio. Esta es nuestra carta a QlQ Esta Unión.`;
---

<Layout title={title} description={description}>
  <div class="embers" aria-hidden="true">
    {Array.from({ length: 14 }).map((_, i) => (
      <span class="ember" style={`left:${4 + i * 7}%; animation-delay:${i * 1.7}s; animation-duration:${13 + (i % 5) * 3}s;`} />
    ))}
  </div>

  <main class="relative">
    <!-- ==================== 1. APERTURA ==================== -->
    <header class="escena escena-alta text-center">
      <img
        src="/logo-trim.webp"
        alt="Cabo Kenedy"
        width="484"
        height="369"
        class="w-44 sm:w-52 h-auto mx-auto mb-10"
      />

      <p class="kicker">CARTA ABIERTA A QLQCOMIDA</p>

      <h1 class="titular">
        Hace <span class="text-primary">{diasCerrados} días</span><br />
        que no encendemos el carbón.
      </h1>
    </header>

    <!-- ==================== 2. LAS GENERACIONES ==================== -->
    <section class="escena escena-alta text-center" aria-label="Tres generaciones">
      <p class="verso brasa reveal" style="--i:0">A mi papá lo trajo mi abuelo.</p>
      <p class="verso brasa reveal" style="--i:1">A mí me trajo mi papá.</p>
      <p class="verso verso-final brasa reveal" style="--i:2">A mis hijos todavía no he podido traerlos.</p>
    </section>

    <!-- ==================== 3. QUIÉNES SOMOS ==================== -->
    <section class="escena carta" aria-label="Quiénes somos">
      <p class="reveal">
        Buenas, QlqComida. Somos <strong>Cabo Kenedy</strong>, de Caraballeda. Abrimos en 1980 y desde
        entonces hacemos una sola cosa: pollo a la brasa, al carbón, dando vueltas.
      </p>

      <p class="reveal">
        El adobo no está escrito en ningún papel. <span class="destaca">Eso se aprende parado al lado del que lo
        está haciendo.</span> Y va con sus arepitas y su ensalada rallada de repollo y zanahoria, esa que la
        gente termina pidiendo aparte porque nunca le alcanza.
      </p>

      <p class="reveal">
        {anosAbiertos} años. Lo mismo, todos los días. A las once de la mañana la avenida olía a
        nosotros y uno sabía qué hora era por el olor.
      </p>
    </section>

    {fotos.length > 0 && (
      <section class="escena" aria-label="Fotos">
        <div class="tira">
          {fotos.map((foto) => (
            <figure class="foto reveal">
              <img src={foto.src} alt={foto.pie} loading="lazy" />
              <figcaption>{foto.pie}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ==================== 4. EL 24 DE JUNIO ==================== -->
    <section class="escena escena-alta text-center" aria-label="El 24 de junio">
      <p class="fecha-grande reveal" aria-hidden="true">24<span>·</span>06</p>
      <p class="verso reveal">Tembló.</p>
      <p class="verso verso-final reveal">No hemos vuelto a abrir.</p>

      <div class="contador reveal">
        <span class="contador-num">{diasCerrados}</span>
        <span class="contador-txt">días cerrados</span>
      </div>
    </section>

    <!-- ==================== 5. LO QUE SE APAGÓ ==================== -->
    <section class="escena carta" aria-label="Lo que se apagó">
      <p class="reveal">
        El señor de los jueves. Las familias que hacían aquí los cumpleaños porque salía más a
        cuenta que alquilar un salón. Los muchachos que llegaban de madrugada con hambre.
      </p>

      <p class="reveal">
        Y la gente que trabaja aquí, que no está en esa cocina por gusto: de ahí come su casa.
        Llevan {diasCerrados} días esperando, igual que nosotros.
      </p>
    </section>

    <!-- ==================== 6. LA CHISPA ==================== -->
    <section class="escena carta" aria-label="La chispa">
      <p class="reveal">
        Uno llega a las once y empieza a prender la brasa. Todavía no hay clientes, no
        hay meseros, no hay a quién impresionar.
      </p>

      <p class="reveal">
        Y entonces el carbón empieza a sonar. <strong>Ese chisporroteo tiene ritmo.</strong> Lo
        tiene siempre, pero hay que estar muy callado para oírlo. Uno se queda quieto. El humo sube,
        la grasa cae, la piel empieza a tostarse. Y por unos minutos no existe nada más: ni el
        teléfono, ni las cuentas, ni el resto del día.
      </p>

      <p class="linea-brasa reveal">Existe la brasa, el pollo y uno. Nada más.</p>

      <p class="reveal">
        Eso no se aprende en ningún curso. Te agarra en el sitio más común del mundo —una parrilla,
        un mesón, un saco de carbón— y de repente entiendes para qué estás ahí. Cocinar deja de ser
        un oficio y pasa a ser <span class="destaca">la manera que uno tiene de decir algo</span>.
      </p>

      <p class="parrafo-alto reveal">
        Eso es lo que está apagado. Y no se apagó porque nos cansamos ni porque el pollo dejó de
        gustar. Se apagó porque tembló.
      </p>

      <p class="reveal">
        Pero una chispa se puede volver a encender. Aquí eso se sabe: La Guaira lleva desde el 99
        aprendiendo a rehacerse encima de lo que quedó. Nadie en este pueblo esconde esa cicatriz.
        La señalan.
      </p>

      <p class="linea-brasa reveal">Del otro lado del mundo le pusieron nombre a esa idea.</p>
    </section>

    <!-- ==================== 7. KINTSUGI ==================== -->
    <section class="escena kintsugi-section text-center" aria-label="Kintsugi">
      <div class="kintsugi-wrap reveal">
        <svg class="kintsugi-svg" viewBox="0 0 220 220" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="oro" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#bf953f" />
              <stop offset="25%" stop-color="#fcf6ba" />
              <stop offset="50%" stop-color="#b38728" />
              <stop offset="75%" stop-color="#fbf5b7" />
              <stop offset="100%" stop-color="#aa771c" />
            </linearGradient>
            <radialGradient id="halo" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(240,176,0,0.10)" />
              <stop offset="100%" stop-color="rgba(240,176,0,0)" />
            </radialGradient>
          </defs>

          <circle cx="110" cy="110" r="105" fill="url(#halo)" class="k-aura" />
          <circle cx="110" cy="110" r="88" class="k-plato" />
          <circle cx="110" cy="110" r="62" class="k-plato k-plato-hondo" />

          <!-- Todas las grietas se quedan dentro del plato: ningún punto pasa
               de un radio de 82, así ni el trazo ni el halo se salen del borde -->
          <path class="k-grieta" style="--d:0.0s" d="M110 30 C 106 56, 118 72, 112 94 C 108 110, 116 126, 110 148 C 106 166, 113 180, 110 190" />
          <path class="k-grieta" style="--d:0.5s" d="M112 94 C 94 90, 78 80, 58 66" />
          <path class="k-grieta" style="--d:0.9s" d="M110 148 C 130 146, 148 152, 168 162" />
          <path class="k-grieta" style="--d:1.2s" d="M112 94 C 128 86, 144 76, 158 60" />
          <path class="k-grieta" style="--d:1.5s" d="M110 148 C 92 156, 78 166, 66 176" />
          <path class="k-grieta k-fina" style="--d:1.8s" d="M58 66 C 50 76, 44 82, 38 88" />
          <path class="k-grieta k-fina" style="--d:2.0s" d="M168 162 C 166 170, 160 176, 152 182" />

          <circle cx="112" cy="94" r="2.6" class="k-nodo" style="--d:2.2s" />
          <circle cx="110" cy="148" r="2.6" class="k-nodo" style="--d:2.35s" />
        </svg>
      </div>

      <p class="k-kanji reveal">金継ぎ</p>
      <h2 class="k-titulo reveal">Kintsugi</h2>
      <p class="k-def reveal">El arte japonés de reparar con oro</p>

      <div class="carta max-w-[34rem] mx-auto mt-6">
        <p class="reveal">
          Los japoneses, cuando se les rompe algo, no lo esconden: rellenan la grieta con oro y la
          dejan a la vista, porque esa grieta también es la historia de la pieza.
        </p>
        <p class="reveal">
          Nosotros no queremos volver a ser exactamente lo que éramos el 23 de junio. Los pedazos
          están todos. Y el oro también: es la gente que trabaja aquí, la que va a poner el
          pecho el día que esto abra otra vez.
        </p>
      </div>

      <p class="k-remate reveal">El oro ya lo tenemos.</p>
    </section>

    <!-- ==================== 8. LA PETICIÓN ==================== -->
    <section class="escena carta" aria-label="Lo que les pedimos">
      <p class="reveal">
        Así que lo que les pedimos es esto, sin adornos: que se sepa que <strong>Cabo Kenedy sigue
        aquí</strong>.
      </p>

      <p class="reveal">
        Todavía no los podemos sentar a la mesa, porque seguimos cerrados. Y cuando volvamos va a
        ser poco a poco: primero solo delivery, hasta que el local aguante otra vez la gente. Pero
        el día que la brasa vuelva a prender, <span class="destaca">el primer pollo sale para
        ustedes</span>. Vengan a Caraballeda y prueben. Si les parece que esto vale la pena,
        cuéntenlo.
      </p>

      <p class="parrafo-alto reveal">
        No estamos pidiendo plata. Estamos pidiendo que alguien cuente que este sitio existe y
        quiere volver a abrir.
      </p>
    </section>

    <!-- ==================== 9. CIERRE ==================== -->
    <section class="escena escena-alta text-center" aria-label="Cierre">
      <p class="verso reveal">El carbón está ahí.</p>
      <p class="verso reveal">La receta está ahí.</p>
      <p class="verso reveal">Nosotros estamos aquí.</p>
      <p class="cierre-remate reveal">Solo falta encenderlo.</p>

      <div class="acciones reveal">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn-wa">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.89S18.6 0 12.05 0Zm0 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.27c0-5.45 4.44-9.88 9.89-9.88a9.83 9.83 0 0 1 9.88 9.89c0 5.45-4.43 9.89-9.88 9.89Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.53.15-.17.2-.3.3-.5.1-.19.05-.37-.02-.51-.08-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.03 1.01-1.03 2.48s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.7.3 1.26.48 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.58-.35Z"/></svg>
          Ayúdanos a encenderlo
        </a>
        <a href={INSTAGRAM} target="_blank" rel="noopener" class="btn-ig">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
          @restaurantcabokenedyoficial
        </a>
      </div>

      <div class="firma reveal">
        <p class="firma-nombre">La familia de Cabo Kenedy</p>
        <p class="firma-lugar">Caraballeda, La Guaira · desde 1980 · {fechaHoy}</p>
      </div>
    </section>

    <!-- ==================== PIE ==================== -->
    <footer class="pie">
      <a href={MAPS} target="_blank" rel="noopener" class="pie-dir">
        Local 01, Av. Principal de Caribe, C.C. Houston PB<br />
        Caraballeda 1165, La Guaira
      </a>

      <div class="pie-enlaces">
        <a href={WHATSAPP} target="_blank" rel="noopener">0414-292-0785</a>
        <span aria-hidden="true">·</span>
        <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* ---------- Brasas ---------- */
  .embers {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ember {
    position: absolute;
    bottom: -10px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-primary-light);
    box-shadow: 0 0 8px 2px rgba(232, 122, 30, 0.5);
    opacity: 0;
    animation-name: emberRise;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
  }

  @keyframes emberRise {
    0%   { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
    12%  { opacity: 0.7; }
    70%  { opacity: 0.35; }
    100% { transform: translateY(-100vh) translateX(28px) scale(0.3); opacity: 0; }
  }

  /* ---------- Escala de espacio ----------
     Una sola serie para todo el documento. Antes cada bloque tenia su
     numero suelto y el salto entre el ritmo interno (14px) y el de las
     escenas (144px) era de 1 a 10: por eso los huecos chocaban. */
  .escena {
    --e2: 0.9rem;
    --e3: 1.5rem;
    --e4: 2.25rem;
    --e5: clamp(1.9rem, 5.5vw, 3rem);

    position: relative;
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--e5) 1.5rem;
  }

  /* Solo la portada respira de más: es la primera pantalla */
  .escena-alta {
    padding-top: calc(var(--e5) * 1.15);
    padding-bottom: calc(var(--e5) * 1.15);
  }

  @media (min-width: 640px) {
    .escena { padding-left: 2rem; padding-right: 2rem; }
  }

  .kicker {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.32em;
    color: rgba(232, 122, 30, 0.8);
    margin-bottom: 2rem;
  }

  .titular {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 7.5vw, 3rem);
    font-weight: 700;
    line-height: 1.18;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  /* ---------- Versos: una linea por respiracion ---------- */
  .verso {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 4.6vw, 1.75rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: 1.15rem;
    text-wrap: balance;
  }

  .verso-final {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Las tres lineas laten como brasas: la misma respiracion, pero cada una
     entra en su turno, como cuando el carbon se va prendiendo por partes. */
  .brasa {
    animation: latirBrasa 4.8s infinite;
    animation-delay: calc(var(--i) * 1.5s);
  }

  /* El carbon no late como un corazon: sube rapido cuando le entra aire y
     baja despacio. De ahi que el pico este al 22% y no en la mitad. */
  @keyframes latirBrasa {
    0% {
      color: #A3958A;
      text-shadow: none;
    }
    22% {
      color: #FFC77A;
      text-shadow: 0 0 20px rgba(232, 122, 30, 0.65), 0 0 52px rgba(232, 122, 30, 0.28);
    }
    34% {
      color: #FFD9A8;
      text-shadow: 0 0 30px rgba(255, 179, 71, 0.8), 0 0 70px rgba(232, 122, 30, 0.32);
    }
    62% {
      color: #C7B5A4;
      text-shadow: 0 0 12px rgba(232, 122, 30, 0.28);
    }
    100% {
      color: #A3958A;
      text-shadow: none;
    }
  }

  /* La ultima nunca se apaga del todo: es la que duele */
  .verso-final.brasa {
    animation-name: latirBrasaFinal;
  }

  @keyframes latirBrasaFinal {
    0% {
      color: #C9BCB0;
      text-shadow: 0 0 10px rgba(232, 122, 30, 0.15);
    }
    22% {
      color: #FFDCAE;
      text-shadow: 0 0 26px rgba(232, 122, 30, 0.7), 0 0 60px rgba(232, 122, 30, 0.3);
    }
    34% {
      color: #FFF3E4;
      text-shadow: 0 0 36px rgba(255, 179, 71, 0.85), 0 0 80px rgba(232, 122, 30, 0.35);
    }
    62% {
      color: #E4D7C9;
      text-shadow: 0 0 16px rgba(232, 122, 30, 0.35);
    }
    100% {
      color: #C9BCB0;
      text-shadow: 0 0 10px rgba(232, 122, 30, 0.15);
    }
  }

  /* La ultima linea prende como prende un carbon: chispazo, titubeo, y
     despues la brasa que se queda viva. Arranca apagada y se enciende
     cuando entra en pantalla. */
  .cierre-remate {
    margin-top: 1.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 6vw, 2.4rem);
    font-weight: 700;
    color: #FFB347;
    text-shadow: 0 0 24px rgba(232, 122, 30, 0.5);
    text-wrap: balance;
  }

  /* Solo se apaga si hay JS que la pueda encender: sin JS se ve encendida */
  :global(body.js-reveal) .cierre-remate {
    color: #6b6058;
    text-shadow: none;
  }

  :global(body.js-reveal) .cierre-remate.visible {
    animation:
      encender 2.4s ease-out 0.35s both,
      brasaViva 4.5s ease-in-out 2.8s infinite;
  }

  @keyframes encender {
    0%   { color: #6b6058; text-shadow: none; }
    6%   { color: #E87A1E; text-shadow: 0 0 16px rgba(232, 122, 30, 0.5); }
    11%  { color: #6b6058; text-shadow: none; }
    19%  { color: #FFB347; text-shadow: 0 0 26px rgba(255, 179, 71, 0.65); }
    26%  { color: #7d6f63; text-shadow: 0 0 6px rgba(232, 122, 30, 0.2); }
    34%  { color: #E87A1E; text-shadow: 0 0 22px rgba(232, 122, 30, 0.55); }
    41%  { color: #9a8574; text-shadow: 0 0 10px rgba(232, 122, 30, 0.3); }
    60%  { color: #FFB347; text-shadow: 0 0 30px rgba(232, 122, 30, 0.6), 0 0 66px rgba(232, 122, 30, 0.25); }
    100% { color: #FFB347; text-shadow: 0 0 24px rgba(232, 122, 30, 0.55), 0 0 58px rgba(232, 122, 30, 0.22); }
  }

  /* Una vez encendida no se queda quieta: respira, como una brasa */
  @keyframes brasaViva {
    0%, 100% { text-shadow: 0 0 24px rgba(232, 122, 30, 0.55), 0 0 58px rgba(232, 122, 30, 0.22); }
    50%      { text-shadow: 0 0 32px rgba(255, 179, 71, 0.7), 0 0 74px rgba(232, 122, 30, 0.3); }
  }

  /* ---------- Parrafos ---------- */
  .carta {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .carta :global(p) {
    margin-bottom: 1.6rem;
  }

  .carta :global(p:last-child) {
    margin-bottom: 0;
  }

  .carta :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Frase encendida dentro del parrafo */
  .carta :global(.destaca) {
    color: var(--color-primary-light);
    font-weight: 600;
  }

  /* Parrafo entero en tono alto: sube el brillo sin gritar */
  .parrafo-alto {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  /* La frase que sostiene la escena: sola, mas grande y latiendo */
  .linea-brasa {
    margin: 1.9rem 0 !important;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 4.4vw, 1.6rem);
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
    color: var(--color-text-primary);
    text-wrap: balance;
    animation: latirBrasaFinal 4.8s infinite;
  }

  /* ---------- El 24 de junio ---------- */
  .fecha-grande {
    font-family: var(--font-display);
