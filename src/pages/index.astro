    .cierre-remate,
    .cierre-remate.visible {
      animation: none;
      color: #FFB347;
      text-shadow: 0 0 24px rgba(232, 122, 30, 0.5);
    }
    :global(body.js-reveal) .reveal,
    :global(body.js-reveal) .reveal.visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length && 'IntersectionObserver' in window) {
    document.body.classList.add('js-reveal');
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        // Tambien se muestra lo que ya quedo por encima de la pantalla: si
        // alguien entra con el scroll a mitad de pagina, esos bloques nunca
        // llegarian a "entrar" y se quedarian invisibles para siempre.
        const yaPaso = entry.boundingClientRect.top < 0;
        if (entry.isIntersecting || yaPaso) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      }
      // El margen positivo abajo hace que cada bloque aparezca ANTES de
      // entrar en pantalla: si no, se cruza el hueco entre escenas mirando
      // una pantalla negra y el vacio se siente el doble de largo.
    }, { rootMargin: '0px 0px 25% 0px' });
    reveals.forEach((el) => io.observe(el));
  }
</script>
